# Copy to backend/.env and adjust. Every setting in app/config.py can be overridden here.

# --- LLM (any OpenAI-compatible endpoint) ---
# Default: Mistral 7B running locally in Ollama - no key, nothing leaves the laptop.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral
# Faster on an 8 GB laptop:
# LLM_MODEL=qwen2.5:3b
# Organiser-approved endpoint (only if approved):
# LLM_BASE_URL=https://<endpoint>/v1
# LLM_API_KEY=<key>
# Turn the LLM off entirely (deterministic cited drafts only):
# LLM_ENABLED=false

# --- Retrieval ---
# RERANK_MODEL=BAAI/bge-reranker-base     # more precise, ~10x slower on CPU
# USE_RERANKER=false
# MATCH_THRESHOLD=50
# VECTOR_BACKEND=numpy                    # if ChromaDB gives trouble

# --- Data ---
# DATA_DIR=C:/path/to/official/dataset

# --- Notifications ---
# WEBHOOK_URL=https://<tenant>.webhook.office.com/...   # Teams incoming webhook; default stores cards for the UI
# WEBHOOK_URL=local://mock
